Options -Indexes
<IfModule mod_mime.c>
AddType text/javascript .mjs
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^cms-rules$ cms-rules.php [L]
RewriteRule ^handbuch(?:/.*)?$ handbuch/index.php [QSA,L]
RewriteRule ^data/cards\.json$ api.php?action=cards-download [L]
RewriteRule ^data/card-texts\.json$ api.php?action=texts-download [L]
RewriteRule ^data/card-texts\.csv$ api.php?action=cards-csv [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(mjs|js|css|html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
<FilesMatch "\.(sqlite|sqlite3|db|sql|log|bak)$">
Require all denied
</FilesMatch>
