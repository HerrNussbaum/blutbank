{
  "name": "octenarius",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write public/*.{mjs,css,html,php} private/*.php scripts/*.php tests/*.mjs",
    "format:check": "prettier --check public/*.{mjs,css,html,php} private/*.php scripts/*.php tests/*.mjs",
    "test": "node tests/check.mjs",
    "start": "php -S 127.0.0.1:4187 -t public router.php",
    "test:server": "python3 tests/test-server.py"
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.26.0",
    "acorn": "^8.19.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10"
  }
}
